# Configuración NO secreta de COLOQUIO. Firebase la carga en el deploy.
# Los secretos van a Secret Manager y se declaran en SECRETOS de main.py.

# Base Firestore con nombre propio (SPEC §7.2). No es la base por defecto.
COLOQUIO_FIRESTORE_DB=coloquio

# Bóveda: solo la superficie de la Fase 5, con el rol coloquio_app.
BOVEDA_INSTANCIA=gestion-paneles:southamerica-east1:paneles-boveda
BOVEDA_USUARIO_IAM=coloquio-app@gestion-paneles.iam
BOVEDA_BASE=paneles_boveda

# Motor de consulta semántica de `paneles` (su API). Vacío = la selección
# semántica degrada a demográfica y lo dice.
PANELES_API_URL=https://gestion-paneles.web.app/api

# Prefijo de país para normalizar celulares a E.164 (WhatsApp).
WHATSAPP_PREFIJO_PAIS=598
